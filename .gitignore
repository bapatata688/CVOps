# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor & IDE State (Shared configs allowed, user state excluded)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
*.swp
*~
*.tmp

# AI Agent Scratchpads & Temporary Workspaces
.agents/teamwork/

# Security Credentials (CRITICAL for Google Cloud / Drive API)
credentials.json
token.json
token.pickle
*.secret.json
client_secret*.json

# Versioned Deliverables Guarantee (Ensures compiled PDFs are tracked)
!cv/**/*.pdf
!evidence/**/*.pdf
!evidence/**/*.docx
